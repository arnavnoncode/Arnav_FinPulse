# Copy this file to .env and fill in real values. Never commit .env itself.

# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///finpulse.db

# Chatbot LLM
ANTHROPIC_API_KEY=your_anthropic_key
CHATBOT_MODEL=claude-sonnet-4-6

# Dashboard -> API connection (set to your deployed API URL in production)
API_URL=http://localhost:8000
