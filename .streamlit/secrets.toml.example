# Streamlit secrets file (for local development only)
# Copy this to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to Git

# API endpoint - use your deployed backend URL
API_URL = "http://localhost:8000"

# Anthropic API key for the chatbot backend
ANTHROPIC_API_KEY = "your_anthropic_key_here"

# Optional: override the default model
CHATBOT_MODEL = "claude-sonnet-4-6"

# Optional: For deployed production setup
# API_URL = "https://finpulse-api.example.com"
